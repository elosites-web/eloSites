# Hashed build assets (JS/CSS) never change for a given filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable image/document URLs: 1-week cache without immutable.
/*.webp
  Cache-Control: public, max-age=604800

/*.avif
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.JPG
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

/cartao/*.webp
  Cache-Control: public, max-age=604800

/cartao/*.png
  Cache-Control: public, max-age=604800

/assets/404/*
  Cache-Control: public, max-age=604800

# The HTML entry point must be revalidated so new asset hashes are picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
